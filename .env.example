# Canonical site URL (no trailing slash). Optional: production builds default to
# https://tarunfahim.com (see src/config/site.ts) and dev uses http://localhost:3000.
# Set this only to override, e.g. for a staging/preview deployment.
NEXT_PUBLIC_SITE_URL=https://tarunfahim.com

# Contact form (server-only, never prefix with NEXT_PUBLIC_). Without RESEND_API_KEY the form
# prints messages to the terminal in dev and shows an error in production.
# Key: resend.com → API Keys. FROM must use a domain verified in Resend (Domains → add
# tarunfahim.com + its DNS records); until then "onboarding@resend.dev" works, but only
# delivers to the email address your Resend account was created with.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="Fahim Faisal Tarun <contact@tarunfahim.com>"
# Inbox that receives enquiries. Defaults to profile.email (src/data/profile.ts).
CONTACT_TO_EMAIL=
